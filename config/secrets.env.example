# Copy this file to config/secrets.env and fill in your values.
# config/secrets.env is GITIGNORED — anything here survives `git pull` and is
# never overwritten by the tracked settings.toml. Put machine-specific values
# (tool paths, storage folders, API key) here so you don't lose them on update.

# TMDB API key (v3). Free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# --- Tool paths (override settings.toml [tools]) ---
# Use plain paths; no quotes/escaping needed in this file. Leave blank to fall
# back to settings.toml or auto-detection.
# Windows example:
#   BLURAYRIPPER_HANDBRAKECLI=C:\Users\Austin\Tools\HandBrakeCLI.exe
BLURAYRIPPER_MAKEMKVCON=
BLURAYRIPPER_HANDBRAKECLI=
BLURAYRIPPER_MKVMERGE=
BLURAYRIPPER_MKVEXTRACT=
BLURAYRIPPER_SUBTITLEEDIT=
BLURAYRIPPER_SUBTITLEEDIT_RUNNER=

# --- Storage folders (override settings.toml [storage]) ---
# Point these at your NAS so they don't get reset on pull.
#   BLURAYRIPPER_STAGING_DIR=Z:\achopra\MakeMKV\BluRayRipper\staging
#   BLURAYRIPPER_OUTPUT_DIR=Z:\Media
BLURAYRIPPER_STAGING_DIR=
BLURAYRIPPER_OUTPUT_DIR=

# --- Crash recovery (optional) ---
# Postgres URL enables persistence + resume-after-restart. Needs the [postgres]
# extra: pip install -e ".[postgres]". Then run: blurayripper db-init
#   BLURAYRIPPER_DATABASE_URL=postgresql://user:pass@localhost:5432/blurayripper
BLURAYRIPPER_DATABASE_URL=
