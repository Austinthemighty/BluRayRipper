# Copy this file to config/secrets.env and fill in your values.
# config/secrets.env is GITIGNORED — anything here survives `git pull` and is
# never overwritten by the tracked settings.toml. Put machine-specific values
# (tool paths, storage folders, API key) here so you don't lose them on update.

# TMDB API key (v3). Free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# OpenSubtitles API key — only needed for "Auto-identify by subtitles" (matches a
# scrambled TV disc's titles to episodes). Free key at
# https://www.opensubtitles.com/en/consumers . Username/password are optional and
# raise the daily download quota.
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# --- Tool paths (override settings.toml [tools]) ---
# Use plain paths; no quotes/escaping needed in this file. Leave blank to fall
# back to settings.toml or auto-detection.
# Windows example:
#   BLURAYRIPPER_HANDBRAKECLI=C:\Users\you\Tools\HandBrakeCLI.exe
BLURAYRIPPER_MAKEMKVCON=
BLURAYRIPPER_HANDBRAKECLI=
BLURAYRIPPER_MKVMERGE=
BLURAYRIPPER_MKVEXTRACT=
BLURAYRIPPER_SUBTITLEEDIT=
BLURAYRIPPER_SUBTITLEEDIT_RUNNER=
BLURAYRIPPER_FFMPEG=
BLURAYRIPPER_DOVITOOL=

# --- Storage folders (override settings.toml [storage]) ---
# Point these at your NAS so they don't get reset on pull.
#   BLURAYRIPPER_STAGING_DIR=Z:\media\MakeMKV\BluRayRipper\staging
#   BLURAYRIPPER_OUTPUT_DIR=Z:\Media
BLURAYRIPPER_STAGING_DIR=
BLURAYRIPPER_OUTPUT_DIR=

# --- Crash recovery (optional) ---
# Postgres URL enables persistence + resume-after-restart. Needs the [postgres]
# extra: pip install -e ".[postgres]". Then run: blurayripper db-init
#   # --- Shared credentials (optional) -------------------------------------------
# Set the SAME value on every box to share the API keys above through Postgres,
# encrypted at rest, instead of copying this file between machines. Generate one
# with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Then run `blurayripper secrets push` on the box that already has the keys.
#
# This protects the DATABASE (and its dumps/replicas) from holding readable
# credentials -- it does NOT protect this file, which must stay readable so the
# box can decrypt unattended at boot. The database URL below therefore stays in
# the clear on purpose: encrypting it with a key stored beside it would protect
# nothing. Needs: pip install -e .[secrets]
BLURAYRIPPER_SECRETS_KEY=

BLURAYRIPPER_DATABASE_URL=postgresql://user:pass@localhost:5432/blurayripper
BLURAYRIPPER_DATABASE_URL=

# --- Clustering (override settings.toml [cluster]) ---
# Per-machine, so it belongs here rather than in the shared settings.toml.
# On the RIP box set BLURAYRIPPER_USE_WORKERS=true (workers encode); the
# `blurayripper worker` machines don't need it. Accepts true/false/1/0/yes/no.
#   BLURAYRIPPER_LOCAL_ENCODE_MAX_HEIGHT=1080   # rip box also encodes <=1080p
#   BLURAYRIPPER_WORKER_DOES_SUBS=true          # sub extraction/OCR on workers
BLURAYRIPPER_USE_WORKERS=
BLURAYRIPPER_LOCAL_ENCODE_MAX_HEIGHT=
BLURAYRIPPER_WORKER_DOES_SUBS=

# --- Notifications (optional) ---
# ntfy-style webhook: pushed when a job needs input or fails.
#   BLURAYRIPPER_NOTIFY_URL=https://ntfy.sh/your-secret-topic
BLURAYRIPPER_NOTIFY_URL=

# --- Subtitle upload export (optional) ---
# Copies each placed .srt here with an OpenSubtitles manual-upload info sheet.
#   BLURAYRIPPER_SUB_UPLOAD_DIR=Z:\media\subtitle_uploads
BLURAYRIPPER_SUB_UPLOAD_DIR=
